# CutBG – zkopíruj do .env a doplň. Soubor .env se necommituje (viz .gitignore).
# URL nasazeného backendu (Modal) – lokálně např. http://10.0.2.2:8000 (Android emulator).
API_BASE_URL=https://lukas--cutbg-api.modal.run
# Volitelný klíč, musí souhlasit s API_KEY na serveru. Prázdné = bez klíče.
API_KEY=
# Maximální delší strana fotky po předzpracování (px).
MAX_IMAGE_SIDE=4096
# Výchozí kvalita exportu: original | medium
EXPORT_DEFAULT_QUALITY=original
